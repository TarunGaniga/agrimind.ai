# AgriMind AI - Environment Variables
# Direct AI Connection Only (No backend servers, no analytics, no external tracking)
#
# Get your Gemini API key from Google AI Studio:
# https://aistudio.google.com/
#
# Expo automatically loads variables prefixed with EXPO_PUBLIC_ into the app bundle.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
